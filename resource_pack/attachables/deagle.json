{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "frontline:deagle",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/held/deagle",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.frontline.held_deagle"
      },
      "animations": {
        "first": "animation.frontline.hold.pistol.first_person",
        "third": "animation.frontline.hold.pistol.third_person",
        "fire": "animation.frontline.gun.deagle.fire",
        "reload": "animation.frontline.gun.deagle.reload",
        "jam": "animation.frontline.gun.deagle.jam",
        "malfunction": "animation.frontline.gun.deagle.malfunction"
      },
      "scripts": {
        "animate": [
          {
            "first": "c.is_first_person"
          },
          {
            "third": "!c.is_first_person"
          },
          {
            "fire": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 0.20) < 0.026"
          },
          {
            "reload": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.80) < 0.026"
          },
          {
            "jam": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.25) < 0.026"
          },
          {
            "malfunction": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 2.70) < 0.026"
          }
        ]
      },
      "render_controllers": [
        "controller.render.frontline.gun_deagle"
      ]
    }
  }
}
