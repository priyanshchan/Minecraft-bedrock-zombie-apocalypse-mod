{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "frontline:ak47",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/held/ak47",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.frontline.held_ak47"
      },
      "animations": {
        "first": "animation.frontline.hold.rifle.first_person",
        "third": "animation.frontline.hold.rifle.third_person",
        "fire": "animation.frontline.gun.ak47.fire",
        "reload": "animation.frontline.gun.ak47.reload",
        "jam": "animation.frontline.gun.ak47.jam",
        "malfunction": "animation.frontline.gun.ak47.malfunction",
        "attachments": "animation.frontline.gun.ak47.attachments"
      },
      "scripts": {
        "animate": [
          {
            "first": "c.is_first_person"
          },
          {
            "third": "!c.is_first_person"
          },
          {
            "fire": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 0.20) < 0.026"
          },
          {
            "reload": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 2.50) < 0.026"
          },
          {
            "jam": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.45) < 0.026"
          },
          {
            "malfunction": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 3.30) < 0.026"
          },
          "attachments"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
