{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "frontline:carl_gustaf",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/held/carl_gustaf",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.frontline.held_carl_gustaf"
      },
      "animations": {
        "first": "animation.frontline.hold.launcher.first_person",
        "third": "animation.frontline.hold.launcher.third_person",
        "fire": "animation.frontline.gun.carl_gustaf.fire",
        "reload": "animation.frontline.gun.carl_gustaf.reload",
        "jam": "animation.frontline.gun.carl_gustaf.jam",
        "malfunction": "animation.frontline.gun.carl_gustaf.malfunction"
      },
      "scripts": {
        "animate": [
          {
            "first": "c.is_first_person"
          },
          {
            "third": "!c.is_first_person"
          },
          {
            "fire": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 0.40) < 0.026"
          },
          {
            "reload": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 4.00) < 0.026"
          },
          {
            "jam": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.80) < 0.026"
          },
          {
            "malfunction": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 4.20) < 0.026"
          }
        ]
      },
      "render_controllers": [
        "controller.render.frontline.gun_carl_gustaf"
      ]
    }
  }
}
