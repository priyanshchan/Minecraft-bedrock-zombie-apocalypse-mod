{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "frontline:barrett",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/held/barrett",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.frontline.held_barrett"
      },
      "animations": {
        "first": "animation.frontline.hold.rifle.first_person",
        "third": "animation.frontline.hold.rifle.third_person",
        "fire": "animation.frontline.gun.barrett.fire",
        "reload": "animation.frontline.gun.barrett.reload",
        "jam": "animation.frontline.gun.barrett.jam",
        "malfunction": "animation.frontline.gun.barrett.malfunction",
        "attachments": "animation.frontline.gun.barrett.attachments"
      },
      "scripts": {
        "animate": [
          {
            "first": "c.is_first_person"
          },
          {
            "third": "!c.is_first_person"
          },
          {
            "fire": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 0.40) < 0.026"
          },
          {
            "reload": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 3.20) < 0.026"
          },
          {
            "jam": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.75) < 0.026"
          },
          {
            "malfunction": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 3.90) < 0.026"
          },
          "attachments"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
