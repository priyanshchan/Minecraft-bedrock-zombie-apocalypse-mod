{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "frontline:mp5",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/held/mp5",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.frontline.held_mp5"
      },
      "animations": {
        "first": "animation.frontline.hold.rifle.first_person",
        "third": "animation.frontline.hold.rifle.third_person",
        "fire": "animation.frontline.gun.mp5.fire",
        "reload": "animation.frontline.gun.mp5.reload",
        "jam": "animation.frontline.gun.mp5.jam",
        "malfunction": "animation.frontline.gun.mp5.malfunction"
      },
      "scripts": {
        "animate": [
          {
            "first": "c.is_first_person"
          },
          {
            "third": "!c.is_first_person"
          },
          {
            "fire": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 0.10) < 0.026"
          },
          {
            "reload": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 2.10) < 0.026"
          },
          {
            "jam": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 1.30) < 0.026"
          },
          {
            "malfunction": "q.cooldown_time_remaining('slot.weapon.mainhand', 0) > 0.0 && math.abs(q.cooldown_time('slot.weapon.mainhand', 0) - 3.00) < 0.026"
          }
        ]
      },
      "render_controllers": [
        "controller.render.frontline.gun_mp5"
      ]
    }
  }
}
